{
  "@@locale": "en",
  "desktopCoreConnecting": "Starting the core…",
  "@desktopCoreConnecting": {
    "description": "Shown while the desktop app waits for the conduitd sidecar to accept its first connection."
  },
  "desktopCoreConnected": "Connected to the core",
  "@desktopCoreConnected": {
    "description": "Status line on the desktop diagnostics screen once the RPC handshake has succeeded."
  },
  "desktopCoreReconnecting": "Reconnecting to the core (attempt {attempt})",
  "@desktopCoreReconnecting": {
    "description": "Banner shown while the desktop app retries a dropped connection to the local sidecar.",
    "placeholders": {
      "attempt": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "desktopCoreUnavailable": "The core is unavailable",
  "@desktopCoreUnavailable": {
    "description": "Headline shown when the desktop app has exhausted its reconnection attempts to the sidecar."
  },
  "desktopCoreVersionMismatch": "This app and its core are different versions. Reinstall Conduit to continue.",
  "@desktopCoreVersionMismatch": {
    "description": "Error shown when the desktop UI and the conduitd sidecar report different protocol versions, which retrying cannot fix."
  },
  "desktopKeyringUnavailable": "No system keyring found, so saved credentials are less protected. Install gnome-keyring or kwallet.",
  "@desktopKeyringUnavailable": {
    "description": "One-time warning on Linux systems where Electron safeStorage has no encryption backend available."
  },
  "desktopQuickAskPlaceholder": "Ask Conduit…",
  "@desktopQuickAskPlaceholder": {
    "description": "Placeholder text in the composer of the global-hotkey quick-ask window."
  },
  "desktopQuickAskContinue": "Continue in main window",
  "@desktopQuickAskContinue": {
    "description": "Button in the quick-ask window that moves the current exchange into the full desktop window."
  },
  "desktopSettingsKeyboardTab": "Keyboard",
  "@desktopSettingsKeyboardTab": {
    "description": "Title of the desktop-only Settings tab where keyboard shortcuts are rebound."
  },
  "desktopShortcutConflict": "{shortcut} is already used by {command}.",
  "@desktopShortcutConflict": {
    "description": "Warning shown when a user assigns a keyboard shortcut that another desktop command already owns.",
    "placeholders": {
      "shortcut": {
        "type": "String",
        "example": "Cmd+K"
      },
      "command": {
        "type": "String",
        "example": "Search"
      }
    }
  },
  "desktopSettingsTitle": "Settings",
  "@desktopSettingsTitle": {
    "description": "Heading of the desktop settings dialog."
  },
  "desktopSettingsNoServers": "No servers configured yet.",
  "@desktopSettingsNoServers": {
    "description": "Shown in the desktop settings Connections tab when no server has been added."
  },
  "desktopSettingsAddServer": "Add a server",
  "@desktopSettingsAddServer": {
    "description": "Link in the desktop settings Connections tab that opens server setup."
  },
  "desktopSettingsSignedIn": "Signed in",
  "@desktopSettingsSignedIn": {
    "description": "Marker next to a configured server the user is still signed into, shown only for servers that are not the active one."
  },
  "desktopSettingsSwitchServer": "Switch",
  "@desktopSettingsSwitchServer": {
    "description": "Button that makes another configured server the active one."
  },
  "desktopSettingsRemoveServer": "Remove",
  "@desktopSettingsRemoveServer": {
    "description": "Button that forgets a configured server."
  },
  "desktopSigningOut": "Signing out…",
  "@desktopSigningOut": {
    "description": "Label on the desktop sign-out button while the request is in flight."
  },
  "desktopSignedOut": "Signed out.",
  "@desktopSignedOut": {
    "description": "Confirmation shown after a sign-out that removed everything it was asked to."
  },
  "desktopSignOutSuperseded": "A newer sign-in replaced this one, so nothing was removed.",
  "@desktopSignOutSuperseded": {
    "description": "Shown when sign-out stopped because the user signed in again while it was running."
  },
  "desktopSignOutIncomplete": "Signed out here, but this device has not finished forgetting. Conduit will retry on the next launch.",
  "@desktopSignOutIncomplete": {
    "description": "Shown when sign-out could not remove everything; the core keeps suppressing cookie reuse until cleanup finishes."
  },
  "desktopChooseFile": "Choose file…",
  "@desktopChooseFile": {
    "description": "Button that opens the file picker for a PEM certificate or key on desktop."
  },
  "desktopReplaceFile": "Replace…",
  "@desktopReplaceFile": {
    "description": "Button that opens the file picker to replace an already-chosen PEM file on desktop."
  },
  "desktopChatsLabel": "Conversations",
  "@desktopChatsLabel": {
    "description": "Accessible name for the desktop conversation sidebar."
  },
  "desktopNoChatsYet": "No conversations yet. Send a message to start one.",
  "@desktopNoChatsYet": {
    "description": "Empty state in the desktop conversation sidebar."
  },
  "desktopSending": "Sending…",
  "@desktopSending": {
    "description": "Label on the desktop send button while a turn is being accepted."
  },
  "desktopSignInMethod": "Sign-in method",
  "@desktopSignInMethod": {
    "description": "Accessible group label for the desktop sign-in method radios (password, LDAP, API key)."
  },
  "desktopChatActions": "Actions for {title}",
  "@desktopChatActions": {
    "description": "Accessible label for the per-conversation action menu in the desktop sidebar. {title} is the conversation title.",
    "placeholders": {
      "title": {
        "type": "String"
      }
    }
  },
  "desktopRenameChat": "Rename",
  "@desktopRenameChat": {
    "description": "Menu item that renames a conversation in the desktop sidebar."
  },
  "desktopPinChat": "Pin",
