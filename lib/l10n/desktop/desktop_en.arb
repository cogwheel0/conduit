    "description": "Menu item that pins a conversation to the top of the desktop sidebar."
  },
  "desktopUnpinChat": "Unpin",
  "@desktopUnpinChat": {
    "description": "Menu item that removes a conversation from the pinned section of the desktop sidebar."
  },
  "desktopArchiveChat": "Archive",
  "@desktopArchiveChat": {
    "description": "Menu item that archives a conversation from the desktop sidebar."
  },
  "desktopDeleteChat": "Delete",
  "@desktopDeleteChat": {
    "description": "Menu item that permanently deletes a conversation from the desktop sidebar."
  },
  "desktopConfirmDelete": "Delete this conversation? This cannot be undone.",
  "@desktopConfirmDelete": {
    "description": "Confirmation shown before deleting a conversation on desktop."
  },
  "desktopRenamePrompt": "New title",
  "@desktopRenamePrompt": {
    "description": "Label of the inline field for renaming a conversation on desktop."
  },
  "desktopSearchChats": "Search conversations",
  "@desktopSearchChats": {
    "description": "Accessible label and placeholder for the desktop sidebar search field."
  },
  "desktopSearchNoResults": "Nothing matched.",
  "@desktopSearchNoResults": {
    "description": "Shown in the desktop sidebar when a search returns no conversations."
  },
  "desktopSearchClear": "Clear search",
  "@desktopSearchClear": {
    "description": "Button that clears the desktop sidebar search field."
  },
  "desktopPickAConversation": "Pick a conversation",
  "@desktopPickAConversation": {
    "description": "Heading of the desktop empty transcript, shown when no conversation is selected."
  },
  "desktopPickAConversationHint": "Choose one from the sidebar, or type below to start a new one.",
  "@desktopPickAConversationHint": {
    "description": "Body of the desktop empty transcript, shown when no conversation is selected."
  },
  "desktopNewConversation": "New conversation",
  "@desktopNewConversation": {
    "description": "Title shown in the desktop transcript header before a conversation has been created."
  }
