#!/bin/bash
# Writes the relay's settings and keys for one run, from /etc/conduit-push/relay.conf
# and the Azure Key Vault it names, into /run/conduit-push (memory only).
#
# The VM's managed identity reads the vault, so no credential is stored on the
# machine, and the keys never touch its disk. Run by conduit-push-relay.service
# before every start. Exits 75 while the vault has keys for neither APNs nor
# FCM; the service tries again a minute later, so keys added to the vault are
# picked up on their own.
set -euo pipefail

CONF=/etc/conduit-push/relay.conf
OUT=/run/conduit-push
SECRETS="$OUT/secrets"
NONROOT=65532 # distroless's nonroot user, which the relay runs as

vault=$(sed -n 's/^KEY_VAULT_NAME=//p' "$CONF")
if [ -z "$vault" ]; then
  echo "fetch-secrets: KEY_VAULT_NAME is not set in $CONF" >&2
  exit 1
fi

token=$(curl -fsS --max-time 10 -H Metadata:true \
  'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net' |
  jq -r .access_token)

umask 077
install -d -m 0750 -o root -g "$NONROOT" "$SECRETS"
work=$(mktemp -d "$OUT/.fetch.XXXXXX")
trap 'rm -rf "$work"' EXIT

# Writes secret $1's value to $2. Answers 1 when the vault has no such secret.
fetch() {
  local status
  status=$(curl -sS --max-time 10 -o "$work/response" -w '%{http_code}' \
    -H "Authorization: Bearer $token" \
    "https://$vault.vault.azure.net/secrets/$1?api-version=7.4")
  case "$status" in
    200) jq -j .value "$work/response" >"$2" ;;
    404) return 1 ;;
    *)
      echo "fetch-secrets: Key Vault answered $status for $1" >&2
      exit 1
      ;;
  esac
}

fetch relay-seal-keys "$work/seal-keys" || {
  echo "fetch-secrets: the vault has no relay-seal-keys" >&2
  exit 1
}
fetch relay-seal-active-kid "$work/seal-active-kid" || {
  echo "fetch-secrets: the vault has no relay-seal-active-kid" >&2
  exit 1
}

env="$work/relay.env"
grep -v -e '^KEY_VAULT_NAME=' -e '^#' -e '^[[:space:]]*$' "$CONF" >"$env"
printf 'RELAY_SEAL_KEYS=%s\n' "$(cat "$work/seal-keys")" >>"$env"
printf 'RELAY_SEAL_ACTIVE_KID=%s\n' "$(cat "$work/seal-active-kid")" >>"$env"

providers=0
if fetch apns-key-id "$work/apns-key-id" && fetch apns-p8 "$work/apns.p8"; then
  printf 'APNS_KEY_ID=%s\n' "$(cat "$work/apns-key-id")" >>"$env"
  printf 'APNS_KEY_P8_FILE=/secrets/apns.p8\n' >>"$env"
  install -m 0400 -o "$NONROOT" -g "$NONROOT" "$work/apns.p8" "$SECRETS/apns.p8"
  providers=$((providers + 1))
else
  rm -f "$SECRETS/apns.p8"
fi
if fetch fcm-service-account "$work/fcm.json"; then
  printf 'FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm.json\n' >>"$env"
  install -m 0400 -o "$NONROOT" -g "$NONROOT" "$work/fcm.json" "$SECRETS/fcm.json"
  providers=$((providers + 1))
else
  rm -f "$SECRETS/fcm.json"
fi

if [ "$providers" -eq 0 ]; then
  echo "fetch-secrets: waiting for APNs (apns-key-id + apns-p8) or FCM (fcm-service-account) keys in $vault" >&2
  exit 75
fi

install -m 0600 -o root -g root "$env" "$OUT/relay.env"
echo "fetch-secrets: ready with $providers provider(s)"
