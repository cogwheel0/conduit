// SDK 27 introduces PrivateCloudComputeLanguageModel. Keep older SDKs on the
// compile-safe path; unknown future SDK majors opt in automatically.
CONDUIT_PCC_SDK_FLAG_180000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_190000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_200000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_210000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_220000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_230000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_240000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_250000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG_260000 = CONDUIT_NO_PCC_SDK
CONDUIT_PCC_SDK_FLAG = $(CONDUIT_PCC_SDK_FLAG_$(SDK_VERSION_MAJOR):default=CONDUIT_PCC_SDK)

SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos*] = $(inherited) $(CONDUIT_PCC_SDK_FLAG)
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator*] = $(inherited) $(CONDUIT_PCC_SDK_FLAG)
