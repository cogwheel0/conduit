# Copy to .env and fill in the four secrets (see README.md for a one-liner).
# Docker Compose reads this file too, for MEILI_MASTER_KEY.

# --- Where the server is reached ---------------------------------------------
# The address the app signs in to. localhost works from the iOS Simulator;
# the Android emulator reaches the host as http://10.0.2.2:3080, and a phone
# needs this machine's LAN address. SSO callbacks redirect here.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
# Docker publishes port 3080 on loopback only; 0.0.0.0 lets a phone on your
# network reach it (and anyone else there).
# LIBRECHAT_BIND=0.0.0.0

# --- Secrets ------------------------------------------------------------------
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# --- Sign-in ------------------------------------------------------------------
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
# Plain HTTP: without this the refresh cookie is marked Secure and a browser
# would drop it. Conduit's own cookie store ignores the flag either way.
SESSION_COOKIE_SECURE=false
# LibreChat's defaults: a 15 minute access token and a 7 day session.
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# --- Abuse protection ---------------------------------------------------------
# Left on deliberately. Stock LibreChat bans a user and IP for any chat or file
# request whose User-Agent is not a browser, so a Conduit request that loses
# its browser User-Agent fails loudly here instead of on a user's server.
# Bans last five minutes instead of the stock two hours; README.md has the
# command that lifts one early.
BAN_VIOLATIONS=true
BAN_DURATION=1000 * 60 * 5
BAN_INTERVAL=20
NON_BROWSER_VIOLATION_SCORE=20
LOGIN_VIOLATION_SCORE=1
REGISTRATION_VIOLATION_SCORE=1
CONCURRENT_VIOLATION_SCORE=1
MESSAGE_VIOLATION_SCORE=1
LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2
LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=40
MESSAGE_IP_WINDOW=1
LIMIT_MESSAGE_USER=false
LOGIN_MAX=20
LOGIN_WINDOW=5

# --- Search -------------------------------------------------------------------
SEARCH=true
MEILI_NO_ANALYTICS=true

# --- Providers ----------------------------------------------------------------
# The Ollama endpoint in librechat.yaml needs no key. Add real provider keys
# here to test those endpoints, e.g. OPENAI_API_KEY=sk-...
ENDPOINTS=agents,custom
OPENAI_API_KEY=user_provided

# Web search (see the commented block in librechat.yaml).
# SERPER_API_KEY=
# FIRECRAWL_API_KEY=
# JINA_API_KEY=

# Code interpreter (LibreChat Code API).
# LIBRECHAT_CODE_API_KEY=

# --- Logging ------------------------------------------------------------------
DEBUG_LOGGING=true
CONSOLE_JSON=false
NO_INDEX=true
