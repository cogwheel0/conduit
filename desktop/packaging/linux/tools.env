# Tools the Linux packaging downloads, pinned (package.sh). Plain KEY=value
# lines, as macos/release.env. package.sh refuses a download whose SHA-256
# differs; NFPM in the environment uses that nfpm instead.

# nfpm (goreleaser/nfpm, MIT): writes the .deb and the .rpm.
NFPM_VERSION=2.48.0
NFPM_URL=https://github.com/goreleaser/nfpm/releases/download/v2.48.0/nfpm_2.48.0_Linux_x86_64.tar.gz
NFPM_SHA256=6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750
