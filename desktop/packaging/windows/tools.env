# What the Windows packaging downloads, pinned (build.ps1). Plain KEY=value
# lines, as macos/release.env. build.ps1 refuses a download whose SHA-256
# differs; ISCC in the environment uses that Inno Setup instead.

# Inno Setup 6 (the 6.x line, which Inno Setup still maintains beside 7.x).
INNO_VERSION=6.7.4
INNO_URL=https://github.com/jrsoftware/issrc/releases/download/is-6_7_4/innosetup-6.7.4.exe
INNO_SHA256=a549929319f9120716677c685535ca4671e4b937b5fdc87e2585f32d8eb30e8c

# WinSparkle (vslavik/winsparkle, MIT): the updater (crates/app/src/updates/
# winsparkle.rs). The release zip's x64 WinSparkle.dll ships beside the app;
# it links the C runtime in, so it needs no Visual C++ Redistributable.
WINSPARKLE_VERSION=0.9.4
WINSPARKLE_URL=https://github.com/vslavik/winsparkle/releases/download/v0.9.4/WinSparkle-0.9.4.zip
WINSPARKLE_SHA256=6037df37fc263bd1650a1c4949681a9d40ffe991d01f35892a406cb5d103c976
