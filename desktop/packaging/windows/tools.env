# Tools the Windows packaging downloads, pinned (build.ps1). Plain
# KEY=value lines, as macos/release.env. build.ps1 refuses a download whose
# SHA-256 differs; ISCC in the environment uses that Inno Setup instead.

# Inno Setup 6 (the 6.x line, which Inno Setup still maintains beside 7.x).
INNO_VERSION=6.7.4
INNO_URL=https://github.com/jrsoftware/issrc/releases/download/is-6_7_4/innosetup-6.7.4.exe
INNO_SHA256=a549929319f9120716677c685535ca4671e4b937b5fdc87e2585f32d8eb30e8c
