<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ConduitWidget.appex, signed with the hardened runtime.

  App extensions must run in the App Sandbox. The widget reads one file,
  the app's snapshot, from the app group's container; bundle.sh adds
  com.apple.security.application-groups with release.env's
  WIDGET_APP_GROUP when it signs (the app gets the same group). No network,
  no files outside the container.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
