# Conduit Desktop release settings, sourced by the scripts in this folder
# and by .github/workflows/release-desktop.yml. Plain KEY=value lines (no
# spaces around '='), so both shells and the workflow can read them.
#
# Nothing here is secret. The secrets (Developer ID certificate, notary
# credentials, Sparkle's private EdDSA key) live in the repository's Actions
# secrets; see docs/RELEASING-DESKTOP.md.

# The GitHub repository releases and the appcast are published to.
RELEASE_REPO=cogwheel0/conduit

# Where the Sparkle appcast lives. Every installed copy reads this URL
# (SUFeedURL), so it must never change once a version has shipped. One
# value picks the hosting; docs/BUILDING-DESKTOP.md compares them. The
# project chose release-asset (2026-11-09); the others stay as alternatives:
#
#   release-asset  appcast.xml on a fixed prerelease, tag `desktop-appcast`:
#                  https://github.com/<repo>/releases/download/desktop-appcast/appcast.xml
#   pages          GitHub Pages from the gh-pages branch:
#                  https://<owner>.github.io/<name>/desktop/appcast.xml
#   branch         the raw file on the `desktop-appcast` branch:
#                  https://raw.githubusercontent.com/<repo>/desktop-appcast/appcast.xml
#
# CONDUIT_APPCAST_URL in the environment overrides the derived URL (local
# update tests, a custom domain).
APPCAST_HOSTING=release-asset

# The tag of the fixed release that carries appcast.xml (release-asset).
APPCAST_RELEASE_TAG=desktop-appcast
# The branch the appcast is committed to (pages: gh-pages; branch: this).
APPCAST_BRANCH=desktop-appcast

# Sparkle 2, pinned. bundle.sh refuses an archive whose SHA-256 differs.
SPARKLE_VERSION=2.10.1
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27

# The oldest macOS the app supports (LSMinimumSystemVersion, the appcast's
# sparkle:minimumSystemVersion, and the deployment target of everything
# bundle.sh builds: Rust, the Swift parts, whisper). Apple silicon only:
# bundle.sh verify holds every Mach-O to ARCH and to MACOS_MIN or lower.
MACOS_MIN=14.0
ARCH=arm64

# The desktop widget (WidgetKit, packaging/macos/widget). The app writes
# the widget's snapshot into this app group's container and the widget
# reads it; both are signed with com.apple.security.application-groups
# naming it. @TEAM_ID@ becomes the signing team: macOS lets a Developer ID
# app use a group prefixed with its own team ID without registering it.
# An ad-hoc build drops the prefix (the system refuses ad-hoc code the
# container anyway). Changing it after a release strands every installed
# widget's snapshot, as SUFeedURL would its updates.
WIDGET_APP_GROUP=@TEAM_ID@.app.cogwheel.conduit.desktop

# The signing team. Empty: read from CONDUIT_SIGN_IDENTITY's certificate.
TEAM_ID=
