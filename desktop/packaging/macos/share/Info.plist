<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Share extension's Info.plist (Contents/PlugIns/ConduitShare.appex).
  share/build.sh replaces the @...@ placeholders:

    @APP_BUNDLE_ID@   the containing app's id (app.cogwheel.conduit.desktop,
                      or a dev/test id); the extension is @APP_BUNDLE_ID@.share
    @BUNDLE_NAME@     the name in the Share menu: the app's name
    @VERSION@, @BUILD@, @MACOS_MIN@   as the app's

  ConduitAppBundleIdentifier names the inbox the extension writes to
  (ShareInbox.swift); the entitlements open that one folder to it.

  What it accepts: text, web links, and up to ten files, images or
  movies, as Conduit's "Open with" does.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>@APP_BUNDLE_ID@.share</string>
	<key>CFBundleName</key>
	<string>ConduitShare</string>
	<key>CFBundleDisplayName</key>
	<string>@BUNDLE_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>ConduitShare</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Without this PlugInKit does not take the extension (pkd: "could
	     not create extension point record", -10814). -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>@MACOS_MIN@</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Tunap Paul. Conduit is open source.</string>
	<key>ConduitAppBundleIdentifier</key>
	<string>@APP_BUNDLE_ID@</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>10</integer>
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>10</integer>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>10</integer>
				<key>NSExtensionActivationSupportsMovieWithMaxCount</key>
				<integer>10</integer>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>ConduitShareViewController</string>
	</dict>
</dict>
</plist>
