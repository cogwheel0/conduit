<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's exceptions, and only these:
  - JIT: V8 in the Electron renderer and main process.
  - the microphone: dictation, calls and note recordings.
  - network client: the daemon talks to the user's servers.
  The daemon itself (conduitd, Dart AOT) needs none of the JIT keys, but it
  is signed with the inherited set because it is spawned by the app.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
